<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Сервіс даних: єдиний компонент із доступом до БД (MS SQL Server, Dapper).
       Обслуговує внутрішній Data API (POST /rpc/{операція}) для backend і розгортає SQL-код БД. -->
  <PropertyGroup>
    <RootNamespace>CorrespondenceSystem.DataService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <!-- SQL-код БД (схема, функції, процедури, тригери, початкові дані) копіюється
       у вихідну директорію і розгортається в БД під час старту (SqlScriptDeployer) -->
  <ItemGroup>
    <None Update="Database\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Прибираємо з вихідної директорії SQL-скрипти, яких уже немає в проєкті: інакше перейменований чи
       перенесений скрипт (напр. демо-дані з Seed у DemoSeed) лишився б там і виконався б -->
  <Target Name="RemoveStaleSqlScripts" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_SqlScriptOutput Include="$(OutDir)Database\**\*.sql" />
      <_SqlScriptStale Include="@(_SqlScriptOutput)"
                       Condition="!Exists('$(MSBuildProjectDirectory)\Database\%(RecursiveDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_SqlScriptStale)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\contracts\CorrespondenceSystem.Contracts.csproj" />
    <ProjectReference Include="..\ServiceDefaults\CorrespondenceSystem.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>

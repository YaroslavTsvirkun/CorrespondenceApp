{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DataApi": {
    "ApiKey": "dev-data-api-key-change-me"
  },
  // Ключ підпису JWT для запуску без Aspire (під Aspire його генерує AppHost — параметр jwt-key)
  "Jwt": {
    "Key": "dev-only-jwt-signing-key-not-for-production-use-32+"
  },
  // Адреса сервісу даних для запуску без Aspire (під Aspire її задає AppHost через service discovery)
  "Services": {
    "dataservice": {
      "http": [ "http://localhost:5090" ]
    }
  }
}

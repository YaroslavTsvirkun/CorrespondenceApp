{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=CorrespondenceApiDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "DeployOnStartup": true,
    "ScriptsPath": "Database",
    "CommandTimeoutSeconds": 120
  },
  "FileStorage": {
    "Bucket": "correspondence",
    "MaxFileSizeMb": 50
  },
  "Cors": {
    "PolicyName": "frontend",
    "AllowedOrigins": [ "http://localhost:5180", "http://localhost:5173" ],
    "AllowedMethods": [],
    "AllowedHeaders": []
  },
  "Jwt": {
    "Key": "kp-correspondence-dev-secret-key-change-me-please-32+chars",
    "Issuer": "CorrespondenceApi",
    "Audience": "CorrespondenceApp"
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataApi": {
    "BaseUrl": "https+http://dataservice",
    "ApiKey": ""
  },
  "FileStorage": {
    "Bucket": "correspondence",
    "MaxFileSizeMb": 50
  },
  "DocumentConversion": {
    "BaseUrl": "http://gotenberg",
    "TimeoutSeconds": 120
  },
  "DocumentEditor": {
    "PublicUrl": "",
    "JwtSecret": "",
    "CallbackBaseUrl": "http://host.docker.internal:5080"
  },
  "Cors": {
    "PolicyName": "frontend",
    "AllowedOrigins": [ "http://localhost:5180", "http://localhost:5173" ],
    "AllowedMethods": [],
    "AllowedHeaders": []
  },
  // Довірені зворотні проксі (IP або мережі CIDR), чиїм заголовкам X-Forwarded-For/-Proto вірити.
  // Порожньо — заголовки ігноруються.
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "CorrespondenceApi",
    "Audience": "CorrespondenceApp"
  }
}
